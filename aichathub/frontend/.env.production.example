# Copy this to frontend/.env.production on the server before building the frontend
# image. Next.js inlines NEXT_PUBLIC_* values into the client bundle at BUILD time
# (not runtime) — this file must exist with real values *before* `docker-compose
# -f docker-compose.prod.yml build frontend` runs, not just before `up`.

# Internal (server-to-server) — used by Next.js rewrites. Stays as the Docker-internal
# service name, same as dev — this one doesn't change for production.
API_GATEWAY_URL=http://api-gateway-nginx

# Public — exposed to the browser. Point at the real public API domain (through Caddy),
# not the internal Docker hostname above — the browser can't resolve Docker DNS.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

NEXT_PUBLIC_GOOGLE_REDIRECT_HANDLER=/auth/callback

# Firebase (real Google Sign-In mechanism, see auth-service's own FIREBASE_* vars) —
# public/client-side config, safe to expose. Same project as dev, reused as-is; the
# only production action needed is adding the real domain to Firebase Console ->
# Authentication -> Authorized domains, not new credentials. Missing this caused a
# real production build failure (FirebaseError: auth/invalid-api-key) — Next.js
# prerenders /login, /register, /reset-password, /auth/callback at BUILD time, and
# those pages initialize Firebase on load, so these must be real values before
# `npm run build` runs, not just before the app starts.
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=CHANGE_ME.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=CHANGE_ME.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME

# Live publishable key (safe to expose) — swap once Stripe account is activated.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME
