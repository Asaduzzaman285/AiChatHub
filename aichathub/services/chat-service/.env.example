APP_NAME="Alveta.ai Chat Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8006

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=chat_app
DB_PASSWORD=chat_secret
DB_SCHEMA=chat_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=internal-secret-change-in-production
AI_GATEWAY_SERVICE_URL=http://ai-gateway-nginx

# S3-compatible storage (MinIO for local)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=aichathub-files
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAX_FILE_SIZE_MB=20

# Synchronous malware scan on every upload (see ClamAvScanner). Off by default for
# local dev — clamd's resident virus DB (~800MB) is heavy for a dev machine; the
# clamav service isn't even in docker-compose.yml's default local service list.
# Set true (and add a clamav container) if you need to test scanning locally.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Sentry — blank is safe, the SDK no-ops with no DSN set.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
