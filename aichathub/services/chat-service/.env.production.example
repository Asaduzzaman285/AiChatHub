APP_NAME="Alveta.ai Chat Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://chat-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=chat_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=chat_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE
AI_GATEWAY_SERVICE_URL=http://ai-gateway-nginx

# Real S3-compatible bucket — production has no MinIO.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=CHANGE_ME
AWS_BUCKET=CHANGE_ME
AWS_ENDPOINT=CHANGE_ME_REAL_S3_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public-read URL for browser-facing previews (e.g. the chat upload thumbnail) —
# separate from AWS_ENDPOINT above, which is the authenticated S3 API endpoint the
# SDK itself uses server-side. R2's S3 API endpoint does NOT serve anonymous reads
# regardless of object ACL; this needs the bucket's own R2.dev public URL or a
# connected custom domain (Cloudflare dashboard → R2 → bucket → Settings → Public
# access). AI analysis itself doesn't depend on this — that path fetches bytes
# server-side via the authenticated SDK (AWS_ENDPOINT), never this URL.
AWS_URL=CHANGE_ME_PUBLIC_BUCKET_URL

MAX_FILE_SIZE_MB=20

# Synchronous malware scan on every upload (see ClamAvScanner) — on in production.
# Points at the clamav sidecar container on the shared docker network.
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
