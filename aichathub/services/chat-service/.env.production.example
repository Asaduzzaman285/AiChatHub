APP_NAME="AI ChatHub Chat Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://chat-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=chat_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=chat_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE

# Real S3-compatible bucket — production has no MinIO. Must be PUBLICLY reachable:
# vision-capable models fetch uploaded files directly from this endpoint, not
# through this app, so a bucket only reachable inside your VPC won't work.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=CHANGE_ME
AWS_BUCKET=CHANGE_ME
AWS_ENDPOINT=CHANGE_ME_REAL_S3_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false

MAX_FILE_SIZE_MB=20

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
