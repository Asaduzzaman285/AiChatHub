APP_NAME="AI ChatHub API Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The only backend service reachable from outside — Caddy proxies API_DOMAIN here.
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Must be IDENTICAL to auth-service's JWT_SECRET — this is how tokens auth-service
# issues get verified here.
JWT_SECRET=CHANGE_ME_32_CHAR_MIN_SECRET_KEY

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

CACHE_DRIVER=redis

AUTH_SERVICE_URL=http://auth-nginx
SUBSCRIPTION_SERVICE_URL=http://subscription-nginx
WALLET_SERVICE_URL=http://wallet-nginx
PAYMENT_SERVICE_URL=http://payment-nginx
AI_GATEWAY_SERVICE_URL=http://ai-gateway-nginx
CHAT_SERVICE_URL=http://chat-nginx
BILLING_SERVICE_URL=http://billing-nginx

# Revisit before launch — 100 req/min/user is a dev-era default, not a value chosen
# for real traffic.
RATE_LIMIT_PER_MINUTE=100

# Sole allowed CORS origin (config/cors.php reads this one var) — the whole reason
# CORS works after deploy is this being set correctly.
FRONTEND_URL=https://app.yourdomain.com
