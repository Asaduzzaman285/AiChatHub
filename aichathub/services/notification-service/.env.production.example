APP_NAME="Alveta.ai Notification Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://notification-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=notif_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=notification_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE

# Real production mail provider — swap from Mailpit. Same Mailgun domain/
# credentials as auth-service (SPF/DKIM verified once for the sending domain,
# used by every service that sends mail). MAIL_MAILER stays 'smtp' (Mailgun's
# SMTP relay), not 'mailgun' — the native API driver needs the
# symfony/mailgun-mailer package, which isn't installed. SMTP is what's already
# proven working in dev against Mailgun's sandbox domain.
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mg.alveta.ai"
MAIL_FROM_NAME="Alveta.ai"

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
