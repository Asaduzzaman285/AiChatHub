APP_NAME="AI ChatHub Notification Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://notification-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=notif_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=notification_svc

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE

# Real production mail provider — swap from Mailpit. Same Mailgun domain/key as
# auth-service (SPF/DKIM verified once for the sending domain, used by every
# service that sends mail).
MAIL_MAILER=mailgun
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAILGUN_DOMAIN=CHANGE_ME.yourdomain.com
MAILGUN_SECRET=CHANGE_ME
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="AI ChatHub"
