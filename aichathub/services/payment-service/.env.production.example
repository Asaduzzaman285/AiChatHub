APP_NAME="AI ChatHub Payment Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://payment-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=payment_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=payment_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
REDIS_QUEUE=payment
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE
WALLET_SERVICE_URL=http://wallet-nginx
BILLING_SERVICE_URL=http://billing-nginx
NOTIFICATION_SERVICE_URL=http://notification-nginx
SUBSCRIPTION_SERVICE_URL=http://subscription-nginx

FRONTEND_URL=https://app.yourdomain.com

# Stripe — live keys, only obtainable once the Stripe account is activated (business
# verification). STRIPE_WEBHOOK_SECRET only exists once the live webhook is
# registered against https://api.yourdomain.com/api/v1/webhooks/stripe (Day 4 of the
# deployment plan) — there is no way to get this value before that registration step.
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# bKash — staying on sandbox for this launch (decided explicitly: Stripe-only for
# Aug 17-18, bKash real credentials are a later phase). Leave these as the sandbox
# values from .env.example, do not swap to production bKash credentials yet.
BKASH_SANDBOX=true
BKASH_APP_KEY=0vWQuCRGiUX7EPVjQDr0EUAYtc
BKASH_APP_SECRET=jcUNPBgbcqEDedNKdvE4G1cAK7D3hCjmJccNPZZBq96QIxxwAMEx
BKASH_USERNAME=01770618567
BKASH_PASSWORD=D7DaC<*E*eG
SANDBOX_BASE_URL=https://tokenized.sandbox.bka.sh
LIVE_BASE_URL=https://tokenized.pay.bka.sh
BKASH_USD_TO_BDT_RATE=122

# SSLCommerz — not wired into any launch-critical flow this session touched; leave
# as sandbox unless it's actually needed for the Aug 17-18 launch.
SSLCZ_STORE_ID=CHANGE_ME
SSLCZ_STORE_PASS=CHANGE_ME
SSLCZ_IS_SANDBOX=true

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
