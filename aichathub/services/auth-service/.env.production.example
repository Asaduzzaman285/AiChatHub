APP_NAME="Alveta.ai Auth Service"
APP_ENV=production
# Run `php artisan key:generate --force` once, after copying this to .env — never
# reuse a dev-generated key. Each service needs its OWN unique key.
APP_KEY=
APP_DEBUG=false
# Internal only — this service isn't publicly reachable in production, Caddy only
# exposes the frontend and api-gateway (see docker-compose.prod.yml).
APP_URL=http://auth-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=auth_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=auth_svc,public

REDIS_HOST=redis
# Must exactly match the REDIS_PASSWORD set for the `redis` container in
# docker-compose.prod.yml / the root .env — every service's connection breaks
# otherwise (redis runs with --requirepass in production, unlike dev).
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

# JWT — this value must be IDENTICAL to api-gateway's JWT_SECRET (api-gateway
# verifies tokens auth-service issues). Generate one strong value, use it in both.
JWT_SECRET=CHANGE_ME_32_CHAR_MIN_SECRET_KEY
JWT_TTL=1440
JWT_REFRESH_TTL=43200

# Dead code path (GoogleOAuthController/Socialite) — Google Sign-In actually goes
# through Firebase (below), not this. Safe to leave as placeholders, never invoked.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/google/callback

# The real Google Sign-In mechanism. Same Firebase project as dev — reuse these
# exact values, no new credential needed. The one required production action is
# adding the real domain to Firebase Console -> Authentication -> Settings ->
# Authorized domains (a dashboard setting, not a code/env change).
FIREBASE_CREDENTIALS=/var/www/firebase-service-account.json
FIREBASE_PROJECT_ID=aichathub-ca2c2

FRONTEND_URL=https://app.yourdomain.com

# Public-facing base URL for email verification / email-change links a user
# actually clicks. Deliberately separate from APP_URL above, which is the
# internal-only Docker hostname in production (auth-service isn't publicly
# reachable, only api-gateway's proxy is) — a link built from APP_URL would
# point somewhere the user's browser can never resolve.
API_PUBLIC_URL=https://api.yourdomain.com

# Must be IDENTICAL across every service's .env — this is the shared secret
# services use to authenticate internal (non-user) requests to each other.
INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE

# Real production mail provider — swap from Mailpit. MAIL_MAILER stays 'smtp'
# (Mailgun's SMTP relay), not 'mailgun' — the native API driver needs the
# symfony/mailgun-mailer package, which isn't installed. SMTP is what's already
# proven working in dev against Mailgun's sandbox domain; only the domain/
# credentials change for the real one.
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mg.alveta.ai"
MAIL_FROM_NAME="Alveta.ai"

QUEUE_CONNECTION=redis
REDIS_QUEUE=auth
CACHE_DRIVER=redis
SESSION_DRIVER=redis

BROADCAST_DRIVER=redis

# Real DSN from the shared "aichathub-backend" Sentry project.
SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
