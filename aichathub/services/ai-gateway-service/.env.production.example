APP_NAME="AI ChatHub AI Gateway Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://ai-gateway-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=ai_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=ai_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
REDIS_QUEUE=ai_gateway
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE
AUTH_SERVICE_URL=http://auth-nginx
WALLET_SERVICE_URL=http://wallet-nginx
SUBSCRIPTION_SERVICE_URL=http://subscription-nginx
CHAT_SERVICE_URL=http://chat-nginx

# AI Providers — only fund/set real keys for whichever provider(s) are actually
# launching (decided Day 1 of the deployment plan). A sandbox key that returns
# "insufficient credits or quota" is worse than an unset one — it fails silently
# mid-request instead of being caught by the model-availability check.
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
XAI_API_KEY=xai-CHANGE_ME
DEEPSEEK_API_KEY=CHANGE_ME
PERPLEXITY_API_KEY=CHANGE_ME
ELEVENLABS_API_KEY=CHANGE_ME

AI_DEFAULT_PROVIDER=deepseek

AI_REQUEST_TIMEOUT_SECONDS=60
AI_STREAM_TIMEOUT_SECONDS=120

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
