APP_NAME="AI ChatHub Subscription Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://subscription-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=sub_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=subscription_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
REDIS_QUEUE=subscription
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE
WALLET_SERVICE_URL=http://wallet-nginx
PAYMENT_SERVICE_URL=http://payment-nginx
BILLING_SERVICE_URL=http://billing-nginx
NOTIFICATION_SERVICE_URL=http://notification-nginx
AUTH_SERVICE_URL=http://auth-nginx

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
