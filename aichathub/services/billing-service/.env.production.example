APP_NAME="AI ChatHub Billing Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://billing-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=billing_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=billing_svc,public

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE
NOTIFICATION_SERVICE_URL=http://notification-nginx

# Invoice storage — same real bucket approach as chat-service (a second bucket, or a
# separate prefix in the same one, either is fine — just needs to be real, not MinIO).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=CHANGE_ME
AWS_BUCKET=CHANGE_ME
AWS_ENDPOINT=CHANGE_ME_REAL_S3_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1
