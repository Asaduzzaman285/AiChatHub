APP_NAME="AI ChatHub Wallet Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://wallet-nginx

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_chathub_db
DB_USERNAME=wallet_app
DB_PASSWORD=CHANGE_ME_ROTATE_FROM_DEV_DEFAULT
DB_SCHEMA=wallet_svc

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_MATCH_REDIS_CONTAINER_PASSWORD
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
BROADCAST_DRIVER=redis

INTERNAL_SERVICE_KEY=CHANGE_ME_SAME_VALUE_IN_EVERY_SERVICE
NOTIFICATION_SERVICE_URL=http://notification-nginx
PAYMENT_SERVICE_URL=http://payment-nginx

CREDIT_BUFFER_DEFAULT=3.00
LOW_BALANCE_THRESHOLD=5.00
